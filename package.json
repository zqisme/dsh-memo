{
  "name": "dsh-memo",
  "version": "0.5.0",
  "description": "DSH 极简备忘录：侧栏一个「备忘录」按钮，主面板一块自动保存的 Markdown 便签，数据存在本机 ~/.dsh/memo/memo.md。",
  "type": "module",
  "license": "MIT",
  "author": "zqisme (https://github.com/zqisme)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zqisme/dsh-memo.git"
  },
  "homepage": "https://github.com/zqisme/dsh-memo#readme",
  "bugs": {
    "url": "https://github.com/zqisme/dsh-memo/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "memo",
    "notes",
    "markdown"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "tools/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
